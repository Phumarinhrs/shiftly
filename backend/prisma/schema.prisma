generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  role      String   @default("DOCTOR") // COORDINATOR | DOCTOR
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     ShiftAssignment[]
  swapsSent       SwapRequest[]     @relation("SwapRequester")
  swapsReceived   SwapRequest[]     @relation("SwapTarget")
  leaveReports    LeaveReport[]
  availability    Availability[]
  scheduleRoster  ScheduleDoctor[]
  activityLogs    ActivityLog[]
  teamMembers     TeamMember[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMember[]
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

model Schedule {
  id        String   @id @default(cuid())
  title     String
  month     Int
  year      Int
  status    String   @default("DRAFT") // DRAFT | PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts       Shift[]
  doctors      ScheduleDoctor[]
  shiftTypes   ShiftType[]
  activityLogs ActivityLog[]

  @@unique([month, year])
}

model ShiftType {
  id         String @id @default(cuid())
  scheduleId String
  name       String // ชื่อเวร เช่น เวรดึก, OPD, ER
  days       String @default("0,1,2,3,4,5,6") // วันที่ใช้เวรนี้ (0=อา,1=จ,...,6=ส) คั่นด้วย comma
  order      Int    @default(0)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model ScheduleDoctor {
  id          String    @id @default(cuid())
  scheduleId  String
  userId      String
  confirmedAt DateTime?

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([scheduleId, userId])
}

model Shift {
  id         String   @id @default(cuid())
  scheduleId String
  date       String   // YYYY-MM-DD
  shiftType  String   // NIGHTSHIFT | OPD | ER | SPECIAL_CLINIC
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule     Schedule          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignments  ShiftAssignment[]
  swapRequests SwapRequest[]
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([shiftId, userId])
}

model SwapRequest {
  id           String   @id @default(cuid())
  shiftId      String
  requesterId  String
  targetUserId String
  reason       String?
  status       String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELLED
  respondedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shift      Shift @relation(fields: [shiftId], references: [id])
  requester  User  @relation("SwapRequester", fields: [requesterId], references: [id])
  targetUser User  @relation("SwapTarget", fields: [targetUserId], references: [id])
}

model LeaveReport {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Availability {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model ActivityLog {
  id         String   @id @default(cuid())
  scheduleId String
  actorId    String?  // ใครเป็นคนทำ (null = ระบบ)
  action     String   // ASSIGN | UNASSIGN | GENERATE | CONFIRM | UNCONFIRM | CREATE | PUBLISH | UNPUBLISH
  detail     String   // คำอธิบายภาษาไทย
  createdAt  DateTime @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id])
}
